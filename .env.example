# Нужен ТОЛЬКО для scripts/generate-audio.mjs.
# В опубликованный сайт не попадает — сайт читает готовые mp3 из бакета.
ELEVENLABS_API_KEY=sk_your_key_here

# Ключ сервисного аккаунта Firebase — им скрипт заливает mp3 в Cloud Storage.
# Скачивается в консоли: Project settings → Service accounts → Generate new key.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
