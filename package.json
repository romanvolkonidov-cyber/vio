    "start": "npm run dev",
    "deploy": "firebase deploy --only hosting",
    "check": "node scripts/check-decodable.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^13.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
