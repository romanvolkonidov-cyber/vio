{
  "name": "vio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read with me — фоникс для русскоязычных семей: от звуков к первым книжкам за 12 недель.",
  "scripts": {
    "audio": "node scripts/generate-audio.mjs",
    "audio:dry": "node scripts/generate-audio.mjs --dry",
